rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共用判斷 ----------

    function isSignedIn() {
      return request.auth != null;
    }

    // 管理員只認 Firebase Authentication 核發的密碼帳號 UID。
    // config/admin 僅能由後台設定，瀏覽器不能讀寫。
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/config/admin)
        && request.auth.uid == get(/databases/$(database)/documents/config/admin).data.adminUid;
    }

    // 訂單欄位白名單：只允許這 11 個欄位，且全部必填。
    // hasOnly 擋掉夾帶額外欄位灌爆文件（單份上限 1MB）的手法。
    function hasExactOrderFields(data) {
      return data.keys().hasOnly([
        'userId', 'shopId', 'shopName', 'buyerName', 'drinkName',
        'size', 'price', 'cups', 'sweetness', 'ice', 'createdAt'
      ]) && data.keys().hasAll([
        'userId', 'shopId', 'shopName', 'buyerName', 'drinkName',
        'size', 'price', 'cups', 'sweetness', 'ice', 'createdAt'
      ]);
    }

    // create 與 update 共用的欄位驗證（注意 size 欄位須用 data['size']，
    // 直接寫 data.size 會與 Map 的 size() 方法混淆）
    function isValidOrder(data) {
      return hasExactOrderFields(data)
        && data.userId is string
        && data.shopId is string && data.shopId.size() > 0 && data.shopId.size() <= 32
        && data.shopName is string && data.shopName.size() > 0 && data.shopName.size() <= 40
        && data.buyerName is string && data.buyerName.size() > 0 && data.buyerName.size() <= 40
        && data.drinkName is string && data.drinkName.size() > 0 && data.drinkName.size() <= 60
        && data['size'] is string && data['size'] in ['M', 'L']
        && data.price is int && data.price >= 0 && data.price <= 500
        && data.cups is int && data.cups > 0 && data.cups <= 100
        && data.sweetness is string && data.sweetness.size() > 0 && data.sweetness.size() <= 20
        && data.ice is string && data.ice.size() > 0 && data.ice.size() <= 20
        && data.createdAt is timestamp;
    }

    // ---------- 集合規則 ----------

    // 設定文件：僅供安全規則內部比對，前端完全不可讀寫
    match /config/{document} {
      allow read, write: if false;
    }

    // 舊的雜湊憑證與探針不再接受任何用戶端操作。
    match /admin_auth/{uid} {
      allow read, write: if false;
    }

    match /admin_probe/{uid} {
      allow read, write: if false;
    }

    match /orders/{orderId} {
      // 注意：任何匿名登入者都能讀取全部訂單（共享看板的既有設計）。
      // 若日後不希望姓名對外公開，需改為依 shopId 或邀請碼限制。
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isValidOrder(request.resource.data)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // update 與 create 套用同一組欄位驗證，並鎖住 userId 與 createdAt，
      // 避免下單後再改成不合理的杯數／金額或冒用他人姓名
      allow update: if isSignedIn()
        && isValidOrder(request.resource.data)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
